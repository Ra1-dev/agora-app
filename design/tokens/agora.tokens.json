  "track": {
    "$description": "Track ink rules (sheet 14). Assign inks in order; inks within clash-delta-e (CIE76) of the organizer accent move to the end. Tracks 9-16 reuse the order as a second run with ring dots and dashed stripes. Over 16: colour by organizer stream. The track name is always shown next to the colour.",
    "order": {
      "$type": "other",
      "$value": [
        "blue",
        "green",
        "yellow",
        "teal",
        "pink",
        "orange",
        "burgundy",
        "purple"
      ]
    },
    "clash-delta-e": {
      "$type": "number",
      "$value": 30
    },
    "edge-inks-light": {
      "$type": "other",
      "$value": [
        "yellow",
        "orange"
      ],
      "$description": "Get a 1px edge in ink at 45% on light surfaces"
    },
    "second-run": {
      "$type": "other",
      "$value": {
        "dot": "ring 3px",
        "stripe": "dashed 7px on, 4px off"
      }
    },
    "print-pantone": {
      "$type": "other",
      "$value": {
        "blue": "286 U",
        "green": "354 U",
        "yellow": "Yellow U",
        "teal": "321 U",
        "pink": "806 U",
        "orange": "151 U",
        "burgundy": "229 U",
        "purple": "2685 U"
      },
      "$description": "Reference only, verify against a Pantone guide"
    },
    "print-bw-pattern": {
      "$type": "other",
      "$value": [
        "solid",
        "diagonal",
        "dots",
        "horizontal",
        "grey",
        "grid",
        "vertical",
        "checks"
      ]
    }
  },
  "event": {
    "$description": "Organizer presence (sheet 15). The frame (grid, components, programme rows, track inks, semantic colours, Source Sans text, icons) never changes. Level 1 Signature: logo + action colour (overrides color.accent). Level 2 Cover: + cover image, organizer font in the event name, default theme. Level 3 Host: + background tint, organizer font in screen headings, bar in brand colours. Monochrome organizer colour -> accent = color.ink. Organizer fonts only at >= 24px and must include Latin + Kazakh Cyrillic.",
    "levels": {
      "$type": "other",
      "$value": [
        "signature",
        "cover",
        "host"
      ]
    },
    "logo-slot": {
      "$type": "other",
      "$value": {
        "width": "132px",
        "height": "22px"
      }
    },
    "font-min-size": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "motion": {
    "$description": "Motion (sheet 17). Opacity and slides up to 24px only; scale only for the album stamp and the splash wreath. Exit is faster than enter. Only Live now (1600ms) and loading skeletons (1400ms) loop. prefers-reduced-motion: slides and scale off, fades <= 120ms, loops stop.",
    "shift-max": {
      "$type": "dimension",
      "$value": "24px"
    },
    "loop-live": {
      "$type": "duration",
      "$value": "1600ms"
    },
    "loop-skeleton": {
      "$type": "duration",
      "$value": "1400ms"
    }
  },
  "$description": "AGORA design tokens. Corners: soft. Colour modes: light (Paros) and dark (Night). Organizer colour overrides color.*.accent."
}